              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            "img, .item-img": {
              "width": "100%",
              "& when (@autoSize)": {
                "height": "100%",
                "object-fit": "cover",
                "& when (@showCardTitle)": {
                  "height": "(@imageHeight * 100px)",
                  "object-fit": "cover"
                }
              }
            },
            ".item:focus, span:focus": {
              "outline": "none"
            },
            ".item": {
              "cursor": "pointer",
              "margin-bottom": "2rem"
            },
            "& when not (@spacing)": {
              ".row": {
                "margin-left": "0",
                "margin-right": "0"
              },
              ".item": {
                "padding": "0",
                "margin": "0"
              }
            },
            ".item-wrapper": {
              "position": "relative",
              "border-radius": "10px",
              "background": "@cardsBg",
              "height": "100%",
              "display": "flex",
              "flex-flow": "column nowrap"
            },
            ".mbr-section-btn": {
              "margin-top": "auto !important"
            },
            ".mbr-section-title": {
              "color": "#ffffff",
              "padding-bottom": "50px",
              "text-align": "center"
            },
            ".item-title": {
              "margin": "20px",
              "color": "#ffffff"
            }
          },
          "_name": "gallery2",
          "_customHTML": "<section class=\"gallery2\" group=\"Sliders & Galleries\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <select title=\"Columns\" name=\"cardsWidth\">\n            <option value=\"12\">1</option>\n            <option value=\"6\">2</option>\n            <option value=\"4\" selected>3</option>\n            <option value=\"3\">4</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Title\" checked>\n        <header>Cards</header>\n        <input type=\"checkbox\" name=\"autoSize\" title=\"Auto Size\" checked>\n        <input type=\"range\" name=\"imageHeight\" title=\"Height\" min=\"1\" max=\"5\" step=\"1\" value=\"3\">\n        <input type=\"checkbox\" title=\"Spacing\" name=\"spacing\" checked>\n        <input type=\"checkbox\" name=\"showCardTitle\" title=\"Title\" checked>\n        <input type=\"color\" name=\"cardsBg\" title=\"BG\" value=\"#d83c47\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" required>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/skillm4/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#062440\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"mbr-section-head\" mbr-if=\"showTitle || showSubtitle\">\n            <h4 class=\"mbr-section-title mbr-fonts-style align-left mb-0\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">\n                <b>Signature Sports Cocktails</b></h4>\n        </div>\n        <div class=\"row\">\n            <div class=\"item features-image col-12 col-md-6 col-lg-{{cardsWidth}}\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/hockey-themed-cocktail-700x392.jpg\" alt>\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText || showButtons\">\n                        <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">\n                            Puck Drop Punch (Hockey)<br><br>A refreshing power-play of vodka, blue curaçao, and grenadine layered with lemon-lime soda and dark cherry \"puck\" ice cubes.&nbsp;</h5>\n                    </div>\n                </div>\n            </div>\n            <div class=\"item features-image col-12 col-md-6 col-lg-{{cardsWidth}}\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/remove-fries-700x378.jpg\" alt>\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText || showButtons\">\n                        <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">\n                            The Linebacker (Football)<br><br>A hard-hitting blend of high-proof bourbon, sweet vermouth, walnut bitters, and a smoke-infused maple syrup.</h5> \n                    </div>\n                </div>\n            </div>\n            <div class=\"item features-image col-12 col-md-6 col-lg-{{cardsWidth}}\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/remove-baseball-700x378.jpg\" alt>\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText || showButtons\">\n                        <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">\n                            The Chalk Line (Baseball)<br><br>A smooth, heavy-hitting blend of aged bourbon, whole milk, heavy cream, and a sneaky \"stolen\" splash of coffee liqueur</h5>\n                    </div>\n                </div>\n            </div>\n            <div class=\"item features-image col-12 col-md-6 col-lg-{{cardsWidth}}\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/soccer-cocktail-black-and-white-some-green.-background-is-soccer-field-700x392.jpg\" alt title>\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText || showButtons\">\n                        <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">Penalty Kick Punch (Soccer)<br><br>A vibrant, grass-green blend of tequila, Midori melon liqueur, and fresh lime juice, topped with a crisp club soda fizz and garnished with a mint sprig \"sideline.\"</h5>\n                    </div>                  \n                </div>\n            </div><div class=\"item features-image col-12 col-md-6 col-lg-{{cardsWidth}}\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/green-golf-cocktails-700x392.jpeg\" alt title data-slide-to=\"4\">\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText || showButtons\">\n                        <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">The Back Nine (Golf)<br><br>A vibrant, grass-green rally of tequila, sour apple liqueur, and fresh lime juice, topped with a crisp club soda fizz and a mint sprig \"flagstick.\"</h5>\n                    </div>                  \n                </div>\n            </div><div class=\"item features-image col-12 col-md-6 col-lg-{{cardsWidth}}\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/yellow-tennis-cocktail-with-round-lemon-and-background-is-normal-tennis-court-700x392.jpg\" alt title data-slide-to=\"5\">\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText || showButtons\">\n                        <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">\n                            The Set Point (Tennis)<br><br>A vibrant, neon-yellow \"ace\" of white rum, limoncello, and fresh lemon juice, topped with a splash of lemon-lime soda.</h5>\n                    </div>                  \n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "vcW4774eKU",
          "_anchor": "gallery2-5",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "content04",
          "_customHTML": "<section group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        \n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"15\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"15\" step=\"1\" value=\"4\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"range\" inline title=\"Col 1 Items\" name=\"menuItems1\" min=\"1\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Col 2 Items\" name=\"menuItems2\" min=\"1\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Col 3 Items\" name=\"menuItems3\" min=\"1\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Col 4 Items\" name=\"menuItems4\" min=\"1\" max=\"10\" step=\"1\" value=\"5\">\n\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"@ADDONS_PATH@/techm4/components/_images/background1.jpg\" parallax>\n            <input type=\"color\" title=\"Background Color\" value=\"#062440\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/techm4/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#232323\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n        \n    </mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"container\">\n        <div class=\"row justify-content-center\">\n            \n            \n            \n            <div class=\"col-6 col-md-3 col-lg-3 md-pb\">\n                \n                <h3 class=\"col-title1 mbr-semibold pb-3 mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".col-title1\">Lagers</h3>\n                <ul class=\"list\" mbr-list mbr-list-grow=\"menuItems1\">\n                    <li class=\"item-wrap align-left\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-smile-face mobi-mbri\" style=\"color: rgb(191, 206, 255); fill: rgb(191, 206, 255);\"></span>\n                        <h4 mbr-text class=\"item1 mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item1\">Pilsner</h4>\n                    </li>\n                <li class=\"item-wrap\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-smile-face mobi-mbri\" style=\"color: rgb(191, 206, 255); fill: rgb(191, 206, 255);\"></span>\n                        <h4 mbr-text class=\"item1 mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item1\">Bud Light</h4>\n                    </li><li class=\"item-wrap\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-smile-face mobi-mbri\" style=\"color: rgb(191, 206, 255); fill: rgb(191, 206, 255);\"></span>\n                        <h4 mbr-text class=\"item1 mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item1\">Miller Lite</h4>\n                    </li><li class=\"item-wrap\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-smile-face mobi-mbri\" style=\"color: rgb(191, 206, 255); fill: rgb(191, 206, 255);\"></span>\n                        <h4 mbr-text class=\"item1 mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item1\">Helles</h4>\n                    </li><li class=\"item-wrap\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-smile-face mobi-mbri\" style=\"color: rgb(191, 206, 255); fill: rgb(191, 206, 255);\"></span>\n                        <h4 mbr-text class=\"item1 mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item1\">Sam Adams</h4>\n                    </li></ul>\n         \n            </div>\n            \n             <div class=\"col-6 col-md-3 col-lg-3 md-pb\">\n                \n                <h3 class=\"col-title2 mbr-semibold pb-3 mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".col-title2\">IPAs</h3>\n                <ul class=\"list\" mbr-list mbr-list-grow=\"menuItems2\">\n                    <li class=\"item-wrap\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-hearth mobi-mbri\" style=\"color: rgb(85, 128, 255); fill: rgb(85, 128, 255);\"></span>\n                        <h4 mbr-text class=\"item2 mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item2\">West Coast IPA</h4>\n                    </li>\n                <li class=\"item-wrap\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-hearth mobi-mbri\" style=\"color: rgb(85, 128, 255); fill: rgb(85, 128, 255);\"></span>\n                        <h4 mbr-text class=\"item2 mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item2\">Lagunitas DayTime</h4>\n                    </li><li class=\"item-wrap\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-hearth mobi-mbri\" style=\"color: rgb(85, 128, 255); fill: rgb(85, 128, 255);\"></span>\n                        <h4 mbr-text class=\"item2 mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item2\">Founders All Day IPA&nbsp;</h4>\n                    </li><li class=\"item-wrap\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-hearth mobi-mbri\" style=\"color: rgb(85, 128, 255); fill: rgb(85, 128, 255);\"></span>\n                        <h4 mbr-text class=\"item2 mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item2\">Dogfish Head 90 Minute IPA&nbsp;</h4>\n                    </li><li class=\"item-wrap\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-hearth mobi-mbri\" style=\"color: rgb(85, 128, 255); fill: rgb(85, 128, 255);\"></span>\n                        <h4 mbr-text class=\"item2 mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item2\">Russian River Pliny the Elder</h4>\n                    </li></ul>\n         \n            </div>\n            \n            \n              <div class=\"col-6 col-md-3 col-lg-3\">\n                \n                <h3 class=\"col-title3 mbr-semibold pb-3 mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".col-title3\">Stouts &amp; Porters&nbsp;</h3>\n                <ul class=\"list\" mbr-list mbr-list-grow=\"menuItems3\">\n                    <li class=\"item-wrap\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-smile-face mobi-mbri\" style=\"color: rgb(255, 138, 115); fill: rgb(255, 138, 115);\"></span>\n                        <h4 mbr-text class=\"item3 mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item3\">Guinness</h4>\n                    </li>\n                <li class=\"item-wrap\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-smile-face mobi-mbri\" style=\"color: rgb(255, 138, 115); fill: rgb(255, 138, 115);\"></span>\n                        <h4 mbr-text class=\"item3 mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item3\">Lancaster Milk Stout</h4>\n                    </li><li class=\"item-wrap\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-smile-face mobi-mbri\" style=\"color: rgb(255, 138, 115); fill: rgb(255, 138, 115);\"></span>\n                        <h4 mbr-text class=\"item3 mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item3\">Anchor Porter</h4>\n                    </li><li class=\"item-wrap\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-smile-face mobi-mbri\" style=\"color: rgb(255, 138, 115); fill: rgb(255, 138, 115);\"></span>\n                        <h4 mbr-text class=\"item3 mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item3\">Founders Porter</h4>\n                    </li><li class=\"item-wrap\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-smile-face mobi-mbri\" style=\"color: rgb(255, 138, 115); fill: rgb(255, 138, 115);\"></span>\n                        <h4 mbr-text class=\"item3 mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item3\">Ten FIDY (Oskar Blues)</h4>\n                    </li></ul>\n         \n            </div>\n                \n         <div class=\"col-6 col-md-3 col-lg-3\">\n                \n                <h3 class=\"col-title4 mbr-semibold pb-3 mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".col-title4\">Wheat Beers</h3>\n                <ul class=\"list\" mbr-list mbr-list-grow=\"menuItems4\">\n                    <li class=\"item-wrap\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-hearth mobi-mbri\" style=\"color: rgb(216, 60, 71); fill: rgb(216, 60, 71);\"></span>\n                        <h4 mbr-text class=\"item4 mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item4\">Blue Moon</h4>\n                    </li>\n                <li class=\"item-wrap\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-hearth mobi-mbri\" style=\"color: rgb(216, 60, 71); fill: rgb(216, 60, 71);\"></span>\n                        <h4 mbr-text class=\"item4 mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item4\">German Hefeweizen</h4>\n                    </li><li class=\"item-wrap\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-hearth mobi-mbri\" style=\"color: rgb(216, 60, 71); fill: rgb(216, 60, 71);\"></span>\n                        <h4 mbr-text class=\"item4 mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item4\">Bell's Oberon</h4>\n                    </li><li class=\"item-wrap\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-hearth mobi-mbri\" style=\"color: rgb(216, 60, 71); fill: rgb(216, 60, 71);\"></span>\n                        <h4 mbr-text class=\"item4 mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item4\">Ayinger Urweisse</h4>\n                    </li><li class=\"item-wrap\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-hearth mobi-mbri\" style=\"color: rgb(216, 60, 71); fill: rgb(216, 60, 71);\"></span>\n                        <h4 mbr-text class=\"item4 mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item4\">Victory Kirsch Gose</h4>\n                    </li></ul>\n         \n            </div>\n            \n            \n            \n        </div>\n    </div>\n</section>",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "li": {
              "list-style": "none"
            },
            ".item-wrap": {
              "display": "flex",
              "align-items": "center",
              "margin-bottom": "14px"
            },
            ".mbr-iconfont": {
              "font-size": "16px!important",
              "padding-right": "12px"
            },
            "h4": {
              "margin": "0"
            },
            ".item": {
              "color": "#57468b"
            },
            "ul": {
              "padding": "0",
              "margin": "0"
            },
            ".col-title": {
              "color": "#57468b"
            },
            ".col-title1": {
              "color": "#bfceff"
            },
            ".col-title2": {
              "color": "#5580ff"
            },
            ".col-title3": {
              "color": "#ff8a73"
            },
            ".col-title4": {
              "color": "#d83c47"
            },
            ".item1": {
              "color": "#efefef"
            },
            ".item2": {
              "color": "#efefef"
            },
            ".item3": {
              "color": "#efefef"
            },
            ".item4": {
              "color": "#efefef"
            },
            "@media (max-width: 768px)": {
              ".md-pb": {
                "padding-bottom": "1rem"
              }
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            }
          },
          "_cid": "vcW6ZA6SUg",
          "_anchor": "content04-h",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value",
              "& when (@gradientBg)": {
                "background": "linear-gradient(0deg, @bg-value, @color2)"
              }
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-section-title": {
              "letter-spacing": "0.1em",
              "text-align": "center"
            },
            ".mbr-section-subtitle": {
              "color": "#ffffff"
            },
            ".image-wrap": {
              "img": {
                "width": "100%"
              }
            },
            ".mbr-desc": {
              "width": "100%"
            },
            ".tab-content": {
              "padding": "4rem 3rem 3rem 3rem",
              "border-top": "3px solid @activeTabColor",
              "-webkit-box-shadow": "0px 4px 26px -5px rgba(0, 0, 0, 0.2)",
              "-moz-box-shadow": "0px 4px 26px -5px rgba(0, 0, 0, 0.2)",
              "box-shadow": "0px 4px 26px -5px rgba(0, 0, 0, 0.2)",
              "background": "@tabsBg"
            },
            ".nav": {
              "border": "none"
            },
            ".nav-tabs": {
              "-webkit-justify-content": "center",
              "justify-content": "center",
              "-webkit-flex-wrap": "wrap",
              "flex-wrap": "wrap"
            },
            ".card-box": {
              "-webkit-align-items": "baseline",
              "align-items": "baseline",
              ".mbr-price": {
                "margin": "0"
              },
              ".mbr-text": {
                "line-height": "1"
              }
            },
            ".nav-tabs .nav-link": {
              "box-sizing": "border-box",
              "color": "@tabsColor",
              "font-style": "normal",
              "font-weight": "500",
              "padding": "0.5rem 1rem",
              "margin": "0px",
              "margin-left": "-0.5px",
              "margin-right": "-0.5px",
              "margin-bottom": "1rem",
              "transition": "all 0.5s",
              "border": "0 !important",
              "&:hover": {
                "color": "@activeTabColor",
                "border": "0 !important"
              },
              "&.active": {
                "color": "@activeTabColor",
                "border": "0 !important",
                "background-color": "transparent",
                "position": "relative"
              }
            },
            "@media (max-width: 767px)": {
              ".container": {
                "padding-left": "0rem",
                "padding-right": "0rem"
              }
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            }
          },
          "_name": "tabs1",
          "_sourceTheme": "restaurantm4",
          "_customHTML": "<section class=\"tabs1 restaurantm4_tabs1 tabs\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" group=\"Tabs\" mbr-class=\"{'mbr-parallax-background':bg.parallax}\" plugins=\"mbr-tabs\">\n\n\t<mbr-parameters>\n\t\t<header>Size</header>\n\t\t<input inline max=\"9\" min=\"0\" name=\"paddingTop\" step=\"1\" title=\"Top\" type=\"range\" value=\"3\">\n\t\t<input inline max=\"9\" min=\"0\" name=\"paddingBottom\" step=\"1\" title=\"Bottom\" type=\"range\" value=\"5\">\n\t\t<select name=\"bootstrapTabs\" title=\"Tabs Count\">\n\t\t\t<option value=\"1\">1</option>\n\t\t\t<option value=\"2\">2</option>\n\t\t\t<option value=\"3\">3</option>\n\t\t\t<option value=\"4\" selected>4</option>\n\t\t\t<option value=\"5\">5</option>\n\t\t\t<option value=\"6\">6</option>\n\t\t\t<option value=\"7\">7</option>\n\t\t\t<option value=\"8\">8</option>\n\t\t</select>\n\t\t<input inline max=\"50\" min=\"1\" name=\"items1\" step=\"1\" title=\"Tab 1 Items\" type=\"range\" value=\"6\">\n\t\t<input condition=\"bootstrapTabs>1\" inline=\"\" max=\"50\" min=\"1\" name=\"items2\" step=\"1\" title=\"Tab 2 Items\" type=\"range\" value=\"14\">\n\t\t<input condition=\"bootstrapTabs>2\" inline=\"\" max=\"50\" min=\"1\" name=\"items3\" step=\"1\" title=\"Tab 3 Items\" type=\"range\" value=\"4\">\n\t\t<input condition=\"bootstrapTabs>3\" inline=\"\" max=\"50\" min=\"1\" name=\"items4\" step=\"1\" title=\"Tab 4 Items\" type=\"range\" value=\"6\">\n\t\t<input condition=\"bootstrapTabs>4\" inline=\"\" max=\"50\" min=\"1\" name=\"items5\" step=\"1\" title=\"Tab 5 Items\" type=\"range\" value=\"4\">\n\t\t<input condition=\"bootstrapTabs>5\" inline=\"\" max=\"50\" min=\"1\" name=\"items6\" step=\"1\" title=\"Tab 6 Items\" type=\"range\" value=\"4\">\n\t\t<input condition=\"bootstrapTabs>6\" inline=\"\" max=\"50\" min=\"1\" name=\"items7\" step=\"1\" title=\"Tab 7 Items\" type=\"range\" value=\"4\">\n\t\t<input condition=\"bootstrapTabs>7\" inline=\"\" max=\"50\" min=\"1\" name=\"items8\" step=\"1\" title=\"Tab 8 Items\" type=\"range\" value=\"4\">\n\t\t<header>Show / Hide</header>\n\t\t<input checked name=\"showTitle\" title=\"Title\" type=\"checkbox\">\n\t\t<input name=\"showSubtitle\" title=\"Subtitle\" type=\"checkbox\">\n\t\t<input name=\"tabsColor\" title=\"Tabs Color\" type=\"color\" value=\"#ffffff\">\n\t\t<input name=\"activeTabColor\" title=\"Active Tab Color\" type=\"color\" value=\"#fac4c9\">\n\t\t<header>Background</header>\n\t\t<input name=\"tabsBg\" title=\"Tabs\" type=\"color\" value=\"#ffffff\">\n\t\t<fieldset name=\"bg\" parallax type=\"background\">\n\t\t\t<input selected title=\"Image\" type=\"image\" value=\"@PROJECT_PATH@/assets/images/sports-bar-food-wings-burgers-pizza-1600x896.jpg\">\n\t\t\t<input title=\"Color\" type=\"color\" value=\"#efefef\">\n\t\t\t<input title=\"Video\" type=\"video\" value=\"https://www.youtube.com/watch?v=pjiVuLVqWQg\">\n\t\t</fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n\t\t<input checked condition=\"bg.type=='color'\" name=\"gradientBg\" title=\"Gradient\" type=\"checkbox\">\n\t\t<input condition=\"gradientBg && bg.type == 'color'\" name=\"color2\" title=\"Color 2\" type=\"color\" value=\"#ffffff\">\n\n\t\t<input checked condition=\"bg.type !== 'color'\" name=\"overlay\" title=\"Overlay\" type=\"checkbox\">\n\t\t<input condition=\"overlay && bg.type !== 'color'\" name=\"overlayColor\" title=\"Overlay Color\" type=\"color\" value=\"#232323\">\n\t\t<input condition=\"overlay && bg.type !== 'color'\" inline max=\"1\" min=\"0\" name=\"overlayOpacity\" step=\"0.1\" title=\"Opacity\" type=\"range\" value=\"0.3\">\n\t</mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\"></div>\n\t<div class=\"container\">\n\t\t<h3 class=\"mbr-section-title align-center mbr-white mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-if=\"showSubtitle\" mbr-theme-style=\"display-5\">\n\t\t\t<i>Discover</i>\n\t\t</h3>\n\t\t<h2 class=\"mbr-section-subtitle align-center mbr-bold mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-if=\"showTitle\" mbr-theme-style=\"display-1\">\n\t\t\tGrub</h2>\n\t\t<div class=\"media-container-row\">\n\t\t\t<div class=\"col-12 col-md-10\">\n\t\t\t\t<ul class=\"nav nav-tabs\" data-app-placeholder=\"Type Title\" role=\"tablist\">\n\t\t\t\t\t<li class=\"nav-item\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrBtnColor,-mbrLink,-mbrBtnRemove\" mbr-buttons mbr-theme-style=\"display-5\" role=\"presentation\"><a aria-controls=\"tech-tab1-content\" class=\"nav-link mbr-fonts-style show active\" data-toggle=\"tab\" href=\"#tabs1-0_tab0\" role=\"tab\" data-app-placeholder=\"Type Text\" aria-selected=\"true\">Appetizers </a></li>\n\t\t\t\t\t<li class=\"nav-item\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrBtnColor,-mbrLink,-mbrBtnRemove\" mbr-buttons mbr-if=\"bootstrapTabs > 1\" mbr-theme-style=\"display-5\" role=\"presentation\"><a aria-controls=\"tech-tab2-content\" class=\"nav-link mbr-fonts-style active\" data-toggle=\"tab\" href=\"#tabs1-0_tab1\" role=\"tab\" data-app-placeholder=\"Type Text\" aria-selected=\"true\">Wings</a></li>\n\t\t\t\t\t<li class=\"nav-item\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrBtnColor,-mbrLink,-mbrBtnRemove\" mbr-buttons mbr-if=\"bootstrapTabs > 2\" mbr-theme-style=\"display-5\" role=\"presentation\"><a aria-controls=\"tech-tab3-content\" class=\"nav-link mbr-fonts-style\" data-toggle=\"tab\" href=\"#tabs1-0_tab2\" role=\"tab\" data-app-placeholder=\"Type Text\" aria-selected=\"true\">Burgers</a></li>\n\t\t\t\t\t<li class=\"nav-item\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrBtnColor,-mbrLink,-mbrBtnRemove\" mbr-buttons mbr-if=\"bootstrapTabs > 3\" mbr-theme-style=\"display-5\" role=\"presentation\"><a aria-controls=\"tech-tab4-content\" class=\"nav-link mbr-fonts-style active\" data-toggle=\"tab\" href=\"#tabs1-0_tab3\" role=\"tab\" data-app-placeholder=\"Type Text\" aria-selected=\"true\">Pizzas</a></li>\n\t\t\t\t\t<li class=\"nav-item\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrBtnColor,-mbrLink,-mbrBtnRemove\" mbr-buttons mbr-if=\"bootstrapTabs > 4\" mbr-theme-style=\"display-5\" role=\"presentation\"><a aria-controls=\"tech-tab5-content\" class=\"nav-link mbr-fonts-style active\" data-toggle=\"tab\" href=\"#tabs1-0_tab4\" role=\"tab\" data-app-placeholder=\"Type Text\" aria-selected=\"true\">Entrees</a></li>\n\t\t\t\t\t<li class=\"nav-item\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrBtnColor,-mbrLink,-mbrBtnRemove\" mbr-buttons mbr-if=\"bootstrapTabs > 5\" mbr-theme-style=\"display-5\" role=\"presentation\"><a aria-controls=\"tech-tab6-content\" class=\"nav-link mbr-fonts-style active\" data-toggle=\"tab\" href=\"#tabs1-0_tab5\" role=\"tab\" data-app-placeholder=\"Type Text\" aria-selected=\"true\">Desserts</a></li>\n\t\t\t\t\t<li class=\"nav-item\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrBtnColor,-mbrLink,-mbrBtnRemove\" mbr-buttons mbr-if=\"bootstrapTabs > 6\" mbr-theme-style=\"display-5\" role=\"presentation\">\n\t\t\t\t\t\t<a aria-controls=\"tech-tab7-content\" aria-expanded=\"true\" class=\"nav-link mbr-fonts-style\" data-toggle=\"tab\" href=\"#tech-tab7-content\" id=\"tech-tab7\" role=\"tab\"> Other </a>\n\t\t\t\t\t</li>\n\t\t\t\t\t<li class=\"nav-item\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrBtnColor,-mbrLink,-mbrBtnRemove\" mbr-buttons mbr-if=\"bootstrapTabs > 7\" mbr-theme-style=\"display-5\" role=\"presentation\">\n\t\t\t\t\t\t<a aria-controls=\"tech-tab8-content\" aria-expanded=\"true\" class=\"nav-link mbr-fonts-style\" data-toggle=\"tab\" href=\"#tech-tab8-content\" id=\"tech-tab8\" role=\"tab\"> Other </a>\n\t\t\t\t\t</li>\n\t\t\t\t</ul>\n\t\t\t\t<div class=\"tab-content\">\n\t\t\t\t\t<div aria-labelledby=\"tech-tab1\" class=\"tab-pane active\" id=\"tech-tab1-content\" role=\"tabpanel\">\n\t\t\t\t\t\t<div class=\"row\" mbr-list mbr-list-grow=\"items1\">\n\t\t\t\t\t\t\t<div class=\"col-md-12 col-lg-6 pb-3 item-wrap\">\n\t\t\t\t\t\t\t\t<div class=\"row align-items-start\">\n\t\t\t\t\t\t\t\t\t<div class=\"col-md-4\">\n\t\t\t\t\t\t\t\t\t\t<div class=\"image-wrap\">\n\t\t\t\t\t\t\t\t\t\t\t<img alt src=\"@PROJECT_PATH@/assets/images/nachos-216x216.jpg\">\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class=\"col-md-8\">\n\t\t\t\t\t\t\t\t\t\t<div class=\"row card-box\">\n\t\t\t\t\t\t\t\t\t\t\t<div class=\"col-md-8\">\n\t\t\t\t\t\t\t\t\t\t\t\t<h3 class=\"mbr-text mbr-fonts-style align-left\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-5\">\n\t\t\t\t\t\t\t\t\t\t\t\t\tLoaded Nachos</h3>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t<div class=\"col-md-4\">\n\t\t\t\t\t\t\t\t\t\t\t\t<p class=\"mbr-price  mbr-fonts-style align-right\" data-app-selector=\".mbr-price\" mbr-theme-style=\"display-5\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t$15 </p>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t<div class=\"col-md-12\">\n\t\t\t\t\t\t\t\t\t\t\t\t<p class=\"mbr-desc mbr-fonts-style align-left\" data-app-selector=\".mbr-desc\" mbr-theme-style=\"display-7\">\n\t\t\t\t\t\t\t\t\t\t\t\t\tCrunchy tortilla chips smothered in melted cheese and topped with seasoned ground beef, beans, jalapeños, sour cream, salsa, and guacamole.</p>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"col-md-12 col-lg-6 pb-3 item-wrap\">\n\t\t\t\t\t\t\t\t<div class=\"row align-items-start\">\n\t\t\t\t\t\t\t\t\t<div class=\"col-md-4\">\n\t\t\t\t\t\t\t\t\t\t<div class=\"image-wrap\">\n\t\t\t\t\t\t\t\t\t\t\t<img alt src=\"@PROJECT_PATH@/assets/images/mozzarella-stic-216x216.jpg\">\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\